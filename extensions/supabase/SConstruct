#!/usr/bin/env python
# Supabase GDExtensionをGodot 4.7向けにbuildする。

import os

godot_cpp = os.path.abspath(ARGUMENTS.get("godot_cpp", "../../tmp/ref_godot_cpp"))  # Godot C++ bindingのsource
out = ARGUMENTS.get("out", "../../tmp/supabase_ext_bin")  # build生成物の出力先
os.makedirs(out, exist_ok=True)
SConsignFile(os.path.join(out, ".sconsign.dblite"))  # build状態も出力先へ置く
env = SConscript(os.path.join(godot_cpp, "SConstruct"), {"api_version": "4.7"})  # Godot 4.7用build環境
env.Append(CPPPATH=["src"])
sources = Glob("src/*.cpp")  # extensionへ含める実装file
# 中間objectも指定された生成物directoryへ揃える。
objects = []
for source in sources:
    name = os.path.splitext(os.path.basename(str(source)))[0]
    objects.append(env.SharedObject(os.path.join(out, "obj", name), source))
# 各OSのloaderが解決できる共有library拡張子を付ける。
target = os.path.join(out, "libgdsupabase{}{}".format(env["suffix"], env["SHLIBSUFFIX"]))
library = env.SharedLibrary(target, source=objects)
env.NoCache(library)
Default(library)
