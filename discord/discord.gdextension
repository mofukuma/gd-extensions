; Discord Botの公開class、platform library、await型を定義するmanifest。

[configuration]
; 初期化入口と読込み可能なGodot版。
entry_symbol = "discord_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
; packageが機種ごとに選ぶnative library。
macos.debug.arm64 = "res://bin/libgddiscord.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://bin/libgddiscord.macos.template_release.arm64.dylib"
linux.debug.x86_64 = "res://bin/libgddiscord.linuxbsd.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgddiscord.linuxbsd.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libgddiscord.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libgddiscord.windows.template_release.x86_64.dll"

[classes]
; gdの型推論とcompileが追跡するclass。
DiscordCallInternal = ""
DiscordWireInternal = "Node"
DiscordClient = ""
Discord = ""

[await]
; 非同期REST methodをawaitした後の型。
DiscordClient.request = "Dictionary"
DiscordClient.send_message = "Dictionary"
DiscordClient.edit_message = "Dictionary"
DiscordClient.delete_message = "Dictionary"
